{
  "manifest_version": 3,
  "name": "agentscripts",
  "version": "0.1.0",
  "description": "Typed, installable per-site tools that an AI agent on this machine can call inside your own logged-in browser.",
  "key": "",
  "permissions": ["userScripts", "nativeMessaging", "tabs", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "agentscripts" },
  "minimum_chrome_version": "138"
}
